{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "curl*": "deny",
      "wget*": "deny",
      "nc*": "deny",
      "ncat*": "deny",
      "ssh*": "deny",
      "scp*": "deny",
      "sftp*": "deny",
      "telnet*": "deny",
      "git push*": "deny",
      "git remote*": "deny",
      "gh *": "deny",
      "npm publish*": "deny",
      "cargo publish*": "deny",
      "cargo login*": "deny",
      "sudo*": "deny",
      "chmod 777*": "deny",
      "*": "allow"
    }
  },
  "agent": {
    "build": {
      "steps": 120
    }
  }
}
