{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "deny",
      "cargo *": "allow",
      "rustfmt *": "allow",
      "./scripts/gate-fast.sh*": "allow",
      "scripts/gate-fast.sh*": "allow",
      "./scripts/invariant-lints.sh*": "allow",
      "./scripts/dash-scan.sh*": "allow",
      "./scripts/test-census.sh*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow"
    }
  },
  "agent": { "build": { "steps": 120 } }
}
